{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grounding output for one candidate category",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "parent_code", "definition_ids", "supporting_reports", "concerns"],
  "properties": {
    "candidate_id": {"type": "string"},
    "parent_code": {"type": "string", "description": "One of the allowed CICTT codes passed in the prompt, or NONE"},
    "definition_ids": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
    "supporting_reports": {"type": "array", "maxItems": 8, "items": {
      "type": "object", "additionalProperties": false, "required": ["report_key", "evidence"],
      "properties": {"report_key": {"type": "string"}, "evidence": {"type": "string", "minLength": 10}}}},
    "concerns": {"type": "string"}
  }
}
